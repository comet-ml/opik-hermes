# Opik connection — copy to ~/.hermes/.env and fill in.

# Local open-source Opik (no auth). The open-source stack serves its API on
# port 5173 by default (configurable via NGINX_PORT). Note: from inside a
# Docker container on macOS, use host.docker.internal instead of localhost.
OPIK_URL_OVERRIDE=http://localhost:5173/api
OPIK_PROJECT_NAME=hermes

# Comet-hosted / self-hosted-with-auth Opik (leave unset for local):
# OPIK_API_KEY=
# OPIK_WORKSPACE=

# Optional tuning:
# HERMES_OPIK_TAGS=production,team-x
# HERMES_OPIK_MAX_CHARS=12000
# HERMES_OPIK_DEBUG=true
